set(modes enabled disabled)
set(runTimeout 14)
if(MODE STREQUAL "committer")
    list(APPEND modes pipeline_disabled both_disabled)
    set(runTimeout 7)
endif()
foreach(mode IN LISTS modes)
    set(switches --unset=APS5_NO_INDIRECT_BATCH --unset=APS5_NO_PIPELINED_INDIRECT)
    if(mode STREQUAL "disabled" OR mode STREQUAL "both_disabled")
        list(APPEND switches APS5_NO_INDIRECT_BATCH=1)
    endif()
    if(mode STREQUAL "pipeline_disabled" OR mode STREQUAL "both_disabled")
        list(APPEND switches APS5_NO_PIPELINED_INDIRECT=1)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env ${switches} "${PROGRAM}" --indirect-batch "${MODE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT ${runTimeout})
    if(result STREQUAL "77")
        message("indirect batch comparison skipped")
        return()
    endif()
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${mode}: ${result}\n${output}\n${errors}")
    endif()
    string(REGEX MATCH "indirect-batch-output [0-9a-f]+" digest "${output}")
    if(digest STREQUAL "")
        message(FATAL_ERROR "${mode}: output digest missing\n${output}\n${errors}")
    endif()
    set(${mode} "${digest}")
    message("${mode}: ${digest}\n${errors}")
endforeach()
foreach(mode IN LISTS modes)
    if(NOT "${enabled}" STREQUAL "${${mode}}")
        message(FATAL_ERROR "${mode} output differs from batched output: ${enabled}, ${${mode}}")
    endif()
endforeach()
