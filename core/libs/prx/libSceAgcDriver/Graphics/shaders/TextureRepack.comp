#version 450

layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Source { uint source[]; };
layout(std430, set = 0, binding = 1) buffer Destination { uint destination[]; };

layout(push_constant) uniform Push {
    uint sourceBase;
    uint destinationBase;
    uint words;
    uint rowWords;
    uint singleElementBytes;
} push;

void main() {
    const uint index = gl_GlobalInvocationID.y * push.rowWords + gl_GlobalInvocationID.x;
    if (gl_GlobalInvocationID.x >= push.rowWords || index >= push.words) return;
    if (push.singleElementBytes != 0u) {
        const uint blockWord = index & ~63u;
        const uint elementWord = push.singleElementBytes >= 4u ? index % (push.singleElementBytes / 4u) : 0u;
        uint value = source[push.sourceBase / 4u + blockWord + elementWord];
        if (push.singleElementBytes == 1u) value = (value & 0xffu) * 0x01010101u;
        if (push.singleElementBytes == 2u) value = (value & 0xffffu) * 0x00010001u;
        destination[push.destinationBase / 4u + index] = value;
        return;
    }
    const uint word = source[push.sourceBase / 4u + index];
    destination[push.destinationBase / 4u + index] = ((word >> 21u) & 0x7ffu) | (((word >> 10u) & 0x7ffu) << 11u) | ((word & 0x3ffu) << 22u);
}
