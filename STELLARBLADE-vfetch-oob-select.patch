+inline std::uint64_t VertexFetchValidBytes(const ShaderRecompiler::VertexAttribute& attribute, std::uint64_t bytes) {
+    const auto stride = (attribute.resource.fields[1] >> 16u) & 0x3fffu;
+    const auto records = static_cast<std::uint64_t>(attribute.resource.fields[2]);
+    const auto select = VertexBufferOutOfBoundsSelect(attribute);
+    if (select == 2u) return records == 0 ? 0 : bytes;
+    if (select == 3u) return std::min(records, bytes);
+    return std::min(records * stride, bytes);
+}
